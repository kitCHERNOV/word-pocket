{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WordPocket dictionary import",
  "type": "object",
  "required": ["words"],
  "properties": {
    "words": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["word", "translation"],
        "properties": {
          "word": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
          "translation": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
          "transcription": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
